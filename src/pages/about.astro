    <script is:inline>
  (function() {
    function removeWorkAndCollapseGap() {
      document.querySelectorAll("a, p, span").forEach((el) => {
        const isWorkText = el.children.length === 0 && (el.textContent || "").trim() === "Work";
        const isWorkHref = el.tagName === "A" && /\/work$/i.test(el.getAttribute("href") || "");

        if (isWorkText || isWorkHref) {
          let targetToHide = el.closest("a") || el;
          while (
            targetToHide.parentElement &&
            targetToHide.parentElement.tagName !== "BODY" &&
            targetToHide.parentElement.tagName !== "NAV" &&
            targetToHide.parentElement.tagName !== "FOOTER" &&
            (targetToHide.parentElement.textContent || "").trim() === "Work"
          ) {
            targetToHide = targetToHide.parentElement;
          }
          targetToHide.style.setProperty("display", "none", "important");
        }
      });
    }

    removeWorkAndCollapseGap();

    function cleanDuplicateBullets() {
      document.querySelectorAll("p").forEach((p) => {
        const text = p.textContent || "";
        if (text.startsWith("• Enraux Client Portal") || text.startsWith("• Discord & Google Meet")) {
          for (let node of p.childNodes) {
            if (node.nodeType === 3 && node.textContent.startsWith("• ")) {
              node.textContent = node.textContent.replace(/^•s+/, "");
              break;
            }
          }
        }
      });
    }

    cleanDuplicateBullets();
    document.addEventListener("DOMContentLoaded", () => {
      removeWorkAndCollapseGap();
      cleanDuplicateBullets();
    });
    window.addEventListener("load", () => {
      removeWorkAndCollapseGap();
      cleanDuplicateBullets();
    });
  })();
</script>
