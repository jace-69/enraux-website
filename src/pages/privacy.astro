        const isWorkHref = el.tagName === "A" && /\/work$/i.test(el.getAttribute("href") || "");

        if (isWorkText || isWorkHref) {
          let targetToHide = el.closest("a") || el;
          while (
            targetToHide.parentElement &&
            targetToHide.parentElement.tagName !== "BODY" &&
            targetToHide.parentElement.tagName !== "NAV" &&
            targetToHide.parentElement.tagName !== "FOOTER" &&
            (targetToHide.parentElement.textContent || "").trim() === "Work"
          ) {
            targetToHide = targetToHide.parentElement;
          }
          targetToHide.style.setProperty("display", "none", "important");
        }
      });
    }

    removeWorkAndCollapseGap();
    document.addEventListener("DOMContentLoaded", removeWorkAndCollapseGap);
    window.addEventListener("load", removeWorkAndCollapseGap);

    // Hydration-proof cleaner for duplicate bullets
    function cleanDuplicateBullets() {
      const items = document.querySelectorAll("li, p, .framer-text, [data-framer-component-type='RichTextContainer']");
      for (let i = 0; i < items.length; i++) {
        const el = items[i];
        const text = el.textContent || "";
        if (text.includes("Enraux Client Portal") || text.includes("Discord & Google Meet")) {
          const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
          let node;
          while ((node = walker.nextNode())) {
            const val = node.nodeValue;
            if (val && /[•·\u2022]/.test(val)) {
              node.nodeValue = val.replace(/[•·\u2022]/g, "").replace(/^\s+/, "");
            }
          }
        }
      }
    }

    cleanDuplicateBullets();
    document.addEventListener("DOMContentLoaded", cleanDuplicateBullets);
    window.addEventListener("load", cleanDuplicateBullets);

    const bulletObserver = new MutationObserver(cleanDuplicateBullets);
    bulletObserver.observe(document.documentElement || document.body, {
      childList: true,
      subtree: true,
      characterData: true,
    });
  })();
</script>
  </Fragment>
</BaseLayout>
