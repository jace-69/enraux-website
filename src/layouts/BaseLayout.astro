    <!-- Safe, Butter-Smooth Scroll & Load Entrance Animation (Layout-Preserving & Navbar-Shielded) -->
    <script is:inline>
      (() => {
        const selector = [
          "h1", "h2", "h3", "h4", "h5", "h6",
          "[data-framer-name*='Card']", "[data-framer-name*='card']",
          "[data-framer-component-type='RichTextContainer']",
          "section",
          ".framer-card",
          "img",
          "[data-framer-background-image-wrapper]"
        ].join(", ");

        const animatedSet = new WeakSet();

        // 1. Strictly Cancel & Shield Navbar Animations
        function cancelNavbarAnimations() {
          const navElements = document.querySelectorAll(
            "nav, [data-framer-name*='Nav' i], [data-framer-name*='Header' i], .framer-stbjvl-container, .framer-1kmos2s-container, nav *, [data-framer-name*='Nav' i] *, [data-framer-name*='Header' i] *, .framer-stbjvl-container *, .framer-1kmos2s-container *"
          );
          navElements.forEach((navEl) => {
            animatedSet.add(navEl);
            if (typeof navEl.getAnimations === "function") {
              navEl.getAnimations().forEach((anim) => anim.cancel());
            }
          });
        }

        // Strict Exclusion Check: skip any Navbar element, descendant, parent wrapper, or top navbar zone
        function isNavbarExcluded(el) {
          if (!el || el.nodeType !== 1) return true;
          if (el.tagName === "BODY" || el.tagName === "HTML" || el.id === "main") return true;

          // 1. Closest nav/header/menu or navbar containers
          if (
            el.closest(
              'nav, [data-framer-name*="Nav" i], [data-framer-name*="Header" i], .framer-stbjvl-container, .framer-1kmos2s-container'
            )
          ) {
            return true;
          }

          // 2. Parent wrapper that contains the Navbar
          if (
            el.querySelector &&
            el.querySelector('nav, [data-framer-name*="Nav" i], .framer-stbjvl-container, .framer-1kmos2s-container')
          ) {
            return true;
          }

          // 3. Exclude Hero Service Tags bar (.framer-21z1vs), Footer (.framer-gUICt), and any Framer native appear-animation containers/children
          if (
            el.closest(".framer-21z1vs") ||
            el.closest(".framer-gUICt") ||
            el.hasAttribute("data-framer-appear-id") ||
            el.closest("[data-framer-appear-id]")
          ) {
            return true;
          }

          // 5. Exclude any element inside an <a> or <button> so button icons & labels never detach
          if (el.closest("a, button")) {
            return true;
          }

          // 6. Exclude any h1–h6 or img inside a RichTextContainer or Card that is already being animated
          if (
            el.parentElement?.closest(
              "[data-framer-component-type='RichTextContainer'], [data-framer-name*='Card' i], .framer-card"
            )
          ) {
            return true;
          }

          return false;
        }

        function animateElement(el) {
          if (!el || animatedSet.has(el)) return;
          if (el.closest('nav, [data-framer-name*="Nav" i], [data-framer-name*="Header" i]')) return;
          animatedSet.add(el);

          // Strictly skip navbar, its descendants, its ancestors, and the top navbar zone
          if (isNavbarExcluded(el)) {
            if (typeof el.getAnimations === "function") {
              el.getAnimations().forEach((anim) => anim.cancel());
            }
            return;
          }

          const style = window.getComputedStyle(el);
          if (
            style.position === "fixed" ||
            style.display === "none" ||
            style.visibility === "hidden"
          ) {
            return;
          }

          // Strict Safety Rule:
          // ONLY animate transform: translateY(22px) -> translateY(0) on elements where
          // window.getComputedStyle(el).transform === 'none' and position !== 'fixed'
          const currentTransform = style.transform;
          const hasNoTransform =
            !currentTransform ||
            currentTransform === "none" ||
            currentTransform === "matrix(1, 0, 0, 1, 0, 0)";
          const canAnimateTranslate = hasNoTransform && style.position !== "fixed";

          if (canAnimateTranslate) {
            el.animate(
              [
                { opacity: 0, transform: "translateY(22px)" },
                { opacity: 1, transform: "translateY(0)" }
              ],
              {
                duration: 650,
                easing: "cubic-bezier(0.22, 1, 0.36, 1)",
                fill: "both"
              }
            );
          } else {
            // If an element already has a Framer transform, animate opacity only!
            el.animate(
              [
                { opacity: 0 },
                { opacity: 1 }
              ],
              {
                duration: 650,
                easing: "cubic-bezier(0.22, 1, 0.36, 1)",
                fill: "both"
              }
            );
          }
        }

        function initEntranceAnimations() {
          cancelNavbarAnimations();

          if (!("IntersectionObserver" in window)) {
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              const vh = window.innerHeight || 800;
              entries.forEach((entry) => {
                const el = entry.target;
                if (!el || animatedSet.has(el)) {
                  observer.unobserve(el);
                  return;
                }

                // Initial observation batch (above-the-fold elements cleanly stay in place)
                if (entry.boundingClientRect.top < vh && entry.boundingClientRect.bottom > 0) {
                  animatedSet.add(el);
                  observer.unobserve(el);
                  return;
                }

                // Otherwise, when entry.isIntersecting
                if (entry.isIntersecting) {
                  observer.unobserve(el);
                  if (isNavbarExcluded(el)) {
                    animatedSet.add(el);
                    return;
                  }
                  const style = window.getComputedStyle(el);
                  if (style.position !== "fixed") {
                    animateElement(el);
                  }
                }
              });
            },
            {
              rootMargin: "0px 0px -40px 0px",
              threshold: 0.05
            }
          );

          const elements = document.querySelectorAll(selector);
          elements.forEach((el) => {
            if (isNavbarExcluded(el)) {
              animatedSet.add(el);
              if (typeof el.getAnimations === "function") {
                el.getAnimations().forEach((anim) => anim.cancel());
              }
              return;
            }
            observer.observe(el);
          });
        }

        // Schedule entrance animations safely without synchronous layout loops
        requestAnimationFrame(cancelNavbarAnimations);
        if (document.readyState === "loading") {
          document.addEventListener(
            "DOMContentLoaded",
            () => {
              requestAnimationFrame(initEntranceAnimations);
            },
            { once: true }
          );
        } else {
          requestAnimationFrame(initEntranceAnimations);
        }
        window.addEventListener("pageshow", cancelNavbarAnimations);

        // Active MutationObserver guard to cancel any animations accidentally attached to Navbar
        let navGuardPending = false;
        const navAnimGuard = new MutationObserver(() => {
          if (navGuardPending) return;
          navGuardPending = true;
          requestAnimationFrame(() => {
            navGuardPending = false;
            cancelNavbarAnimations();
          });
        });

        const navTargets = document.querySelectorAll(
          "nav, .framer-stbjvl-container, .framer-1kmos2s-container"
        );
        navTargets.forEach((el) => {
          navAnimGuard.observe(el, {
            childList: true,
            subtree: true,
          });
        });

        setTimeout(() => {
          navAnimGuard.disconnect();
        }, 6000);
      })();
    </script>

    <!-- Fallback Menu Drawer Script for Static Blog Articles (#2-#8 where Framer script_main is absent) -->
    <script is:inline>
      (() => {
        function initStaticMenuDrawer() {
          const hasFramerBundle = !!document.querySelector('script[data-framer-bundle="main"]');
