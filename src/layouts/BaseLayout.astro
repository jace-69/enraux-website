        const origCreateElement = document.createElement.bind(document);
        document.createElement = function (tagName, options) {
          const el = origCreateElement(tagName, options);
          const tag = (tagName || "").toLowerCase();
          if (tag === "iframe") {
            const origSetAttribute = el.setAttribute.bind(el);
            el.setAttribute = function (name, value) {
              const val = String(value || "");
              if (
                (name === "src" && (val.includes("framer.com/edit") || val.includes("editorbar"))) ||
                (name === "id" && val.includes("framer-editorbar"))
              ) {
                return;
              }
              return origSetAttribute(name, value);
            };
            try {
              Object.defineProperty(el, "src", {
                set(val) {
                  const s = String(val || "");
                  if (s.includes("framer.com/edit") || s.includes("editorbar")) {
                    return;
                  }
                  origSetAttribute("src", val);
                },
                get() {
                  return el.getAttribute("src") || "";
                },
              });
            } catch (e) {}
          }
          return el;
        };

        const editorbarSelector =
          "#__framer-editorbar, #__framer-editorbar-container, #__framer-editorbar-button, [id*='framer-editorbar'], [class*='framer-editorbar'], iframe[src*='framer.com/edit'], iframe[src*='editorbar']";

        function purgeFramerIcons() {
          try {
            const icons = document.querySelectorAll('link[rel*="icon"]');
            for (let i = 0; i < icons.length; i++) {
              const el = icons[i];
              const href = el.getAttribute("href") || "";
              if (href.includes("framerusercontent.com")) {
                el.remove();
              }
            }
          } catch (e) {}
        }

        function purgeEditorBar() {
          purgeStorage();
          purgeFramerIcons();
          const elements = document.querySelectorAll(editorbarSelector);
          for (let i = 0; i < elements.length; i++) {
            elements[i].remove();
          }
        }

        const headIconObserver = new MutationObserver(() => {
          purgeFramerIcons();
        });

        if (document.head) {
          headIconObserver.observe(document.head, { childList: true });
        } else {
          document.addEventListener("DOMContentLoaded", () => {
            if (document.head) {
              headIconObserver.observe(document.head, { childList: true });
            }
          });
        }

        purgeEditorBar();
        document.addEventListener("DOMContentLoaded", purgeEditorBar);
        window.addEventListener("load", purgeEditorBar);
      })();
