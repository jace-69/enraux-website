    <!-- Client-Side Duplicate Bullet Cleaner (Hydration Guard) -->
    <script is:inline>
      (() => {
        function cleanDuplicateBullets() {
          const items = document.querySelectorAll(
            "li, p, .framer-text, [data-framer-component-type='RichTextContainer']"
          );
          for (let i = 0; i < items.length; i++) {
            const el = items[i];
            const text = el.textContent || "";
            if (
              text.includes("Enraux Client Portal") ||
              text.includes("Discord & Google Meet")
            ) {
              const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
              let node;
              while ((node = walker.nextNode())) {
                const val = node.nodeValue;
                if (val && /[•·\u2022]/.test(val)) {
                  const newVal = val.replace(/[•·\u2022]/g, "").replace(/^\s+/, "");
                  if (newVal !== val) {
                    node.nodeValue = newVal;
                  }
                }
              }
            }
          }
        }

        // Run after Framer hydration completes to eliminate React #418/#423 text mismatches
        window.addEventListener("load", cleanDuplicateBullets);
        (window.__enrauxWhenHydrated || ((fn) => fn()))(() => {
          cleanDuplicateBullets();
          window.addEventListener("pageshow", cleanDuplicateBullets);
          setTimeout(cleanDuplicateBullets, 1500);

          let bulletPending = false;
          const observer = new MutationObserver(() => {
            if (bulletPending) return;
            bulletPending = true;
            requestAnimationFrame(() => {
              bulletPending = false;
              cleanDuplicateBullets();
            });
          });
          observer.observe(document.documentElement || document.body, {
            childList: true,
            subtree: true,
            characterData: true,
          });

          setTimeout(() => {
            observer.disconnect();
          }, 5000);
        });
      })();
    </script>

