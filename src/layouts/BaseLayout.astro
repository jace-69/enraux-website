          drawer.setAttribute("aria-hidden", "true");
          const normPath = window.location.pathname.replace(/\/+$/, "") || "/";
          const isHome = normPath === "/";
          const isAbout = normPath === "/about";
          const isService = normPath === "/service";
          const isPricing = normPath === "/pricing";
          const isBlog = normPath.startsWith("/blog");
          const isContact = normPath === "/contact";

          drawer.innerHTML = [
            '<div class="enraux-drawer-nav" role="navigation" aria-label="Menu Navigation">',
            '  <a class="enraux-drawer-link' + (isHome ? ' is-active' : '') + '" href="/">Home</a>',
