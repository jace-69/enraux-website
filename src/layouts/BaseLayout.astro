            if (!clickedCard || clickedCard.getAttribute("data-framer-name") !== "Closed") return;
            const container = clickedCard.closest(".framer-uwP5E");
            if (!container) return;

            setTimeout(() => {
              const openSiblings = container.querySelectorAll('.framer-0Ejqx[data-framer-name="Open"]');
              openSiblings.forEach((other) => {
                if (other === clickedCard) return;
                const rect = other.getBoundingClientRect();
                const x = rect.left + Math.min(20, Math.max(2, rect.width / 2));
                const y = rect.top + Math.min(20, Math.max(2, rect.height / 2));

                isAutoClosingFaq = true;
                try {
