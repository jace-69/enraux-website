    <!-- Smooth Desktop Translucent Cursor System -->
    <script is:inline>
      (() => {
        if (typeof window === "undefined" || !window.matchMedia) return;

        const mediaQuery = window.matchMedia("(hover: hover) and (pointer: fine)");

        let cursorEl = null;
        let rafId = null;
        let isVisible = false;
        let isHovered = false;
        let isPressed = false;
        let curX = -100;
        let curY = -100;
        let targetX = -100;
        let targetY = -100;
        let curScale = 1;
        let isAttached = false;

        const INTERACTIVE_SELECTOR =
          "a, button, select, input, textarea, label, [role='button'], [role='link'], .framer-r1ebey, .framer-qvIpE, .framer-upW4V, .framer-0WrPu, .framer-l6xzuo, .framer-QgsVx";

