              rawHref.startsWith("javascript:") ||
              a.target === "_blank" ||
              a.hasAttribute("download")
            ) {
              return;
            }

            const serviceTarget = getContactServiceTarget(a);
            const cleanRoute = serviceTarget || toCleanRootPath(rawHref);
            let targetUrl = null;

            if (cleanRoute && cleanRoute.startsWith("/")) {
              targetUrl = window.location.origin + cleanRoute;
            }

            if (targetUrl) {
              let targetObj;
              try {
                targetObj = new URL(targetUrl, window.location.origin);
              } catch {
                return;
              }

              if (targetObj.pathname === window.location.pathname && targetObj.search === window.location.search) {
                if (targetObj.hash) {
                  e.preventDefault();
                  const targetEl = document.getElementById(targetObj.hash.slice(1));
                  if (targetEl) targetEl.scrollIntoView({ behavior: "smooth" });
                  history.replaceState(null, "", targetObj.pathname + targetObj.hash);
                  return;
                }
                // Otherwise (exact same URL), just return cleanly without locking isNavigating
                return;
              }

              e.preventDefault();
              e.stopImmediatePropagation();
              e.stopPropagation();

              if (isNavigating) return;
              isNavigating = true;
              setTimeout(() => {
                isNavigating = false;
              }, 1200);

              // Immediate navigation so browser's @view-transition captures both outgoing and incoming pages simultaneously
              try {
                window.location.href = targetUrl;
              } catch {
                isNavigating = false;
              }
            }
          },
          true
        );
      })();
    </script>

    <!-- Hydration State Detector & Task Scheduler -->
    <script is:inline>
      (() => {
        window.__enrauxWhenHydrated = function (fn) {
          if (typeof fn !== "function") return;
          const hasFramer =
            !!document.querySelector('script[data-framer-bundle="main"]') &&
            !!document.getElementById("main")?.hasAttribute("data-framer-hydrate-v2");

          if (!hasFramer) {
            window.__enrauxHydrated = true;
            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", () => fn(), { once: true });
            } else {
              fn();
            }
            return;
          }

          const isReady = () =>
            !!(
              window.MotionIsMounted === true ||
              document.querySelector("[data-framer-form-hydrated], [data-hydrated]")
            );

          if (isReady()) {
            window.__enrauxHydrated = true;
            fn();
            return;
          }

          const startTime = Date.now();
          const poll = setInterval(() => {
            if (isReady() || Date.now() - startTime >= 3200) {
              clearInterval(poll);
              window.__enrauxHydrated = true;
              fn();
            }
          }, 80);
        };
      })();
    </script>

