---
interface Props {
  title?: string;
  description?: string;
  cssFile?: string;
  bodyClass?: string;
  inlineCss?: string;
}

const {
  title = "Enraux Studio",
  description = "Enraux engineers high-converting landing pages, visual identity, and monthly ad creatives that turn cold clicks into profitable revenue.",
  cssFile = "/styles/index.css",
  bodyClass = "",
  inlineCss = "",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://framerusercontent.com" crossorigin />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
    {inlineCss ? (
      <style is:inline set:html={inlineCss} />
    ) : (
      <link rel="stylesheet" href={cssFile.includes("?") ? cssFile : `${cssFile}?v=2`} fetchpriority="high" />
    )}

    <style is:global>
      /* 1. Canvas Lock & Framer Stacked Scale-Back View Transition */
      html {
        background-color: #060606 !important;
      }

      @view-transition {
        navigation: auto;
      }

      ::view-transition {
        background-color: #060606;
      }

      ::view-transition-group(root) {
        animation-duration: 0.52s;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      }

      ::view-transition-old(root) {
        z-index: 1;
        transform-origin: center top;
        overflow: hidden;
        mix-blend-mode: normal !important;
        animation: framerStackExit 0.52s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      ::view-transition-new(root) {
        z-index: 2;
        transform-origin: center bottom;
        overflow: hidden;
        mix-blend-mode: normal !important;
        animation: framerStackEnter 0.52s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      @keyframes framerStackExit {
        0% {
          transform: translate3d(0, 0, 0) scale(1);
          opacity: 1;
        }
        100% {
          transform: translate3d(0, -3.5vh, 0) scale(0.94);
          opacity: 0.25;
        }
      }

      @keyframes framerStackEnter {
        0% {
          transform: translate3d(0, 100vh, 0);
          opacity: 1;
        }
        100% {
          transform: translate3d(0, 0, 0);
          opacity: 1;
        }
      }

      /* 2. Ancestors of the Navbar must NEVER have transforms applied (prevents position: fixed detachment) */
      html,
      body,
      #main,
      .framer-ZHkV9,
      .framer-i4eIh,
      [data-layout-template="true"] {
        transform: none !important;
        -webkit-transform: none !important;
        filter: none !important;
        perspective: none !important;
      }

      /* 2. Form Autofill & Browser Input Selection Overrides */
      input:-webkit-autofill,
      input:-webkit-autofill:hover,
      input:-webkit-autofill:focus,
      input:-webkit-autofill:active,
      textarea:-webkit-autofill,
      textarea:-webkit-autofill:hover,
      textarea:-webkit-autofill:focus,
      textarea:-webkit-autofill:active,
      select:-webkit-autofill,
      select:-webkit-autofill:hover,
      select:-webkit-autofill:focus,
      select:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 1000px #ffffff inset !important;
        box-shadow: 0 0 0 1000px #ffffff inset !important;
        -webkit-text-fill-color: #0a0a0a !important;
        color: #0a0a0a !important;
        caret-color: #0a0a0a !important;
        transition: background-color 9999s ease-out 0s !important;
      }

      /* Form Input, Textarea & Select Base Color */
      input,
      textarea,
      select,
      .framer-form-input {
        color: #0a0a0a !important;
        caret-color: #0a0a0a !important;
      }

      input:not(:placeholder-shown),
      textarea:not(:placeholder-shown),
      input:focus,
      textarea:focus,
      select {
        -webkit-text-fill-color: #0a0a0a !important;
        color: #0a0a0a !important;
      }

      input::placeholder,
      textarea::placeholder,
      .framer-form-input::placeholder {
        color: rgba(10, 10, 10, 0.45) !important;
        -webkit-text-fill-color: rgba(10, 10, 10, 0.45) !important;
        opacity: 1 !important;
      }

      /* Form Selection Styling */
      input::selection,
      input::-moz-selection,
      textarea::selection,
      textarea::-moz-selection,
      select::selection,
      select::-moz-selection,
      .framer-form-input::selection,
      .framer-form-input::-moz-selection,
      form ::selection,
      form ::-moz-selection {
        background-color: rgba(10, 10, 10, 0.15) !important;
        color: #0a0a0a !important;
        -webkit-text-fill-color: #0a0a0a !important;
      }

      /* 3. Article Body Subheadings Left Alignment & Uniform Scale Guarantee */
      .framer-1e374s0 h5,
      .framer-1e374s0 h2,
      .framer-46ixfy h5,
      .framer-46ixfy h2,
      .framer-n8vu8z h5,
      .framer-n8vu8z h2 {
        font-family: var(--framer-font-family, "Neue Montreal Medium", sans-serif) !important;
        font-size: 36px !important;
        font-weight: 500 !important;
        line-height: 1.125em !important;
        letter-spacing: 0em !important;
        text-align: left !important;
        --framer-text-alignment: start !important;
      }
      @media (min-width: 810px) and (max-width: 1439.98px) {
        .framer-1e374s0 h5, .framer-1e374s0 h2,
        .framer-46ixfy h5, .framer-46ixfy h2,
        .framer-n8vu8z h5, .framer-n8vu8z h2 {
          font-size: 27px !important;
        }
      }
      @media (max-width: 809.98px) {
        .framer-1e374s0 h5, .framer-1e374s0 h2,
        .framer-46ixfy h5, .framer-46ixfy h2,
        .framer-n8vu8z h5, .framer-n8vu8z h2 {
          font-size: 24px !important;
        }
      }
      /* Fix pretty-printed newline + <br> double-spacing and missing top margin on first heading of .framer-n8vu8z across all 8 blog articles */
      .framer-1e374s0 .framer-46ixfy,
      .framer-1e374s0 .framer-n8vu8z {
        white-space: normal !important;
      }
      .framer-1e374s0 .framer-n8vu8z h5:first-child,
      .framer-1e374s0 .framer-n8vu8z h2:first-child {
        margin-top: 40px !important;
      }

      /* 4. Framer Editorbar Complete Removal */
      #__framer-editorbar,
      #__framer-editorbar-container,
      #__framer-editorbar-button,
      [id*='framer-editorbar'],
      [class*='framer-editorbar'],
      iframe[src*='framer.com/edit'],
      iframe[src*='editorbar'] {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
        width: 0 !important;
        height: 0 !important;
        position: absolute !important;
        top: -9999px !important;
        left: -9999px !important;
        z-index: -9999 !important;
      }

      /* 5. Prevent pretty-printed HTML newlines/spaces inside Framer navbar RichText containers from expanding white-space: pre/pre-wrap into 95px ghost lines */
      nav.framer-z10Ts .framer-nw6mze,
      nav.framer-z10Ts .framer-da95kg,
      nav.framer-z10Ts .framer-wvhydi,
      nav.framer-z10Ts .framer-k0x150,
      nav.framer-z10Ts .framer-1hvascq {
        white-space: nowrap !important;
      }
      nav.framer-z10Ts .framer-10chgwv {
        white-space: normal !important;
      }

      /* Prevent pretty-printed HTML newlines/spaces from expanding white-space: pre in Footer & Blog link/button components (especially unhydrated Blogs #2-#8) */
      .framer-gUICt .framer-18255hk [data-framer-component-type="RichTextContainer"],
      .framer-gUICt .framer-7exzhq,
      .framer-gUICt .framer-zfvdnq,
      .framer-gUICt .framer-1w8crey,
      .framer-gUICt .framer-9qg7n9,
      .framer-gUICt .framer-cfevr7,
      .framer-gUICt .framer-xjk71,
      .framer-gUICt .framer-1ibtwga,
      .framer-gUICt .framer-1cq1jn1,
      .framer-gUICt .framer-e74mop,
      .framer-gUICt .framer-1woln0z,
      .framer-gUICt .framer-cqvuk3,
      .framer-gUICt .framer-17b79cl,
      .framer-gUICt .framer-2lslxg,
      .framer-gUICt .framer-1v3fnso,
      .framer-gUICt .framer-koi1nl,
      .framer-gUICt .framer-15k7w5t,
      .framer-gUICt .framer-51x1x9,
      .framer-gUICt .framer-468j90,
      .framer-gUICt .framer-1o6jzmf,
      .framer-gUICt .framer-djkety,
      .framer-gUICt .framer-xubrmh,
      .framer-gUICt .framer-u3ylk6,
      .framer-gUICt .framer-1ftcss9,
      .framer-gUICt .framer-vmdjkj,
      .framer-TJio6 .framer-16j2efq,
      .framer-jby5y .framer-15o3nqe,
      .framer-jby5y .framer-1nndp6r,
      .framer-jby5y .framer-1hepzt8,
      .framer-jby5y .framer-199jy99,
      .framer-jby5y .framer-1sisjzd,
      .framer-jby5y .framer-9kjxqx,
      .framer-jby5y .framer-c5274b,
      .framer-jby5y .framer-1e1c26e,
      .framer-jby5y .framer-1fkcte0,
      .framer-wrcOp .framer-1e635t7,
      .framer-rhiQ5 .framer-19qyw7o,
      .framer-PyJCR .framer-ori6dw,
      .framer-PyJCR .framer-wq8r24,
      .framer-PyJCR .framer-1du0gh2 {
        white-space: nowrap !important;
      }

      /* Prevent pretty-printed HTML newlines/spaces from expanding white-space: pre in Hero Service Tags bar */
      .framer-21z1vs [data-framer-component-type="RichTextContainer"],
      .framer-jWZoB .framer-7xo6i5,
      .framer-jWZoB .framer-t8enk1,
      .framer-jWZoB .framer-1j81ief,
      .framer-jWZoB .framer-r52ssz,
      .framer-jWZoB .framer-17i8qxy {
        white-space: nowrap !important;
      }

      /* 6. Hide Redundant Project Budget Section in Contact Form & Location Block */
      form.framer-4i9xwl .framer-48sj51,
      form[data-framer-form] [data-framer-name="Tag"] {
        display: none !important;
      }
      .framer-aphij7[data-framer-name="Location"], .framer-hd91nv[data-framer-name="Location"] { display: none !important; }

      /* 7. Fallback Menu Drawer for Static Blog Articles (#2-#8 where Framer script_main is absent) */
      html.enraux-static-menu-open,
      body.enraux-static-menu-open {
        overflow: hidden !important;
      }
      body.enraux-static-menu-open .framer-ZHkV9 {
        z-index: auto !important;
        isolation: auto !important;
      }
      body.enraux-static-menu-open .framer-1kmos2s-container {
        z-index: 99999 !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
      }
      .framer-qvIpE.enraux-icon-open .framer-dz4byv {
        z-index: 1;
        position: absolute !important;
        top: calc(50% - 1px) !important;
        left: calc(50% - 9px) !important;
        transform: rotate(45deg) !important;
        transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .framer-qvIpE.enraux-icon-open .framer-15dkvrp {
        z-index: 1;
        position: absolute !important;
        top: calc(50% - 1px) !important;
        left: calc(50% - 9px) !important;
        transform: rotate(-45deg) !important;
        transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .framer-qvIpE.enraux-icon-open .framer-1uq5uon {
        opacity: 0 !important;
        transition: opacity 0.2s ease;
      }
      .framer-qvIpE .framer-dz4byv,
      .framer-qvIpE .framer-15dkvrp,
      .framer-qvIpE .framer-1uq5uon {
        transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
      }
      #enraux-static-menu-drawer {
        position: fixed;
        inset: 0;
        z-index: 99990;
        background-color: #ffffff;
        color: #0d0d0d;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding-top: 104px;
        overflow-y: auto;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translate3d(0, -100%, 0);
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
                    opacity 0.28s ease,
                    visibility 0.45s;
      }
      #enraux-static-menu-drawer.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translate3d(0, 0, 0);
      }
      #enraux-static-menu-drawer .enraux-drawer-nav {
        flex: 1 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        padding: 32px 20px;
      }
      #enraux-static-menu-drawer .enraux-drawer-link {
        font-family: "Neue Montreal Medium", "Neue Montreal Regular", sans-serif;
        font-size: clamp(34px, 3.6vw, 52px);
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: #0d0d0d;
        text-decoration: none;
        text-align: center;
        transition: opacity 0.2s ease;
      }
      #enraux-static-menu-drawer .enraux-drawer-link:hover {
        opacity: 0.6;
      }
      #enraux-static-menu-drawer .enraux-drawer-link.is-active {
        text-decoration: underline;
        text-underline-offset: 6px;
        text-decoration-thickness: 3px;
      }
      #enraux-static-menu-drawer .enraux-drawer-footer {
        background-color: #f3f3f3;
        width: 100%;
        padding: 24px 32px;
        flex: none;
      }
      #enraux-static-menu-drawer .enraux-drawer-footer-inner {
        max-width: 1376px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        font-family: "Neue Montreal Regular", sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: #0d0d0d;
      }
      #enraux-static-menu-drawer .enraux-drawer-legal {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      #enraux-static-menu-drawer .enraux-drawer-legal a {
        color: #0d0d0d;
        text-decoration: none;
        transition: opacity 0.2s ease;
      }
      #enraux-static-menu-drawer .enraux-drawer-legal a:hover {
        opacity: 0.6;
        text-decoration: underline;
      }
      @media (max-width: 809.98px) {
        #enraux-static-menu-drawer {
          padding-top: 72px;
        }
        #enraux-static-menu-drawer .enraux-drawer-nav {
          gap: 16px;
        }
        #enraux-static-menu-drawer .enraux-drawer-link {
          font-size: 36px;
        }
        #enraux-static-menu-drawer .enraux-drawer-footer {
          padding: 20px;
        }
        #enraux-static-menu-drawer .enraux-drawer-footer-inner {
          flex-direction: column;
          justify-content: center;
          text-align: center;
          gap: 8px;
        }
      }

      /* Unified Country Code + WhatsApp Input Combo */
      .enraux-phone-combo {
        display: flex !important;
        flex-direction: row !important;
        align-items: stretch !important;
        width: 100% !important;
        background: var(--framer-input-background, #ffffff) !important;
        border-radius: 4px !important;
        overflow: hidden !important;
        box-sizing: border-box !important;
        position: relative !important;
        transition: box-shadow 0.15s ease !important;
        padding: 0 !important;
      }

      .enraux-phone-combo:focus-within {
        box-shadow: inset 0 0 0 1px #0d0d0d !important;
      }

      .enraux-phone-combo .enraux-country-wrap {
        position: relative !important;
        flex: 0 0 43% !important;
        min-width: 122px !important;
        max-width: 190px !important;
        border-right: 1px solid rgba(13, 13, 13, 0.14) !important;
        display: flex !important;
        align-items: center !important;
        background: transparent !important;
        transition: background-color 0.2s ease !important;
      }

      .enraux-phone-combo .enraux-country-wrap.enraux-country-nudge {
        background-color: rgba(13, 13, 13, 0.08) !important;
      }

      .enraux-phone-combo .enraux-country-wrap::after {
        content: "" !important;
        position: absolute !important;
        right: 10px !important;
        top: 50% !important;
        width: 14px !important;
        height: 14px !important;
        transform: translateY(-50%) !important;
        pointer-events: none !important;
        background-color: #0d0d0d !important;
        -webkit-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16'><path d='M 3.5 6 L 8 10.5 L 12.5 6' fill='transparent' stroke-width='1.5' stroke='rgb(13,13,13)' stroke-linecap='round' stroke-linejoin='round'/></svg>") center / 14px no-repeat !important;
        mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16'><path d='M 3.5 6 L 8 10.5 L 12.5 6' fill='transparent' stroke-width='1.5' stroke='rgb(13,13,13)' stroke-linecap='round' stroke-linejoin='round'/></svg>") center / 14px no-repeat !important;
      }

      .enraux-phone-combo select.enraux-country-select {
        width: 100% !important;
        height: 100% !important;
        appearance: none !important;
        -webkit-appearance: none !important;
        background: transparent !important;
        border: none !important;
        outline: none !important;
        color: #0d0d0d !important;
        font-family: var(--framer-input-font-family, "Neue Montreal Regular", sans-serif) !important;
        font-size: var(--framer-input-font-size, 16px) !important;
        font-weight: 400 !important;
        line-height: 1.25em !important;
        padding: var(--framer-input-padding, 14px) 28px var(--framer-input-padding, 14px) var(--framer-input-padding, 14px) !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        cursor: pointer !important;
      }

      .enraux-phone-combo select.enraux-country-select:invalid {
        color: rgba(13, 13, 13, 0.72) !important;
      }

      .enraux-phone-combo select.enraux-country-select option {
        color: #0d0d0d !important;
        background: #ffffff !important;
      }

      .enraux-phone-combo input[type="tel"].framer-form-input {
        flex: 1 1 auto !important;
        min-width: 0 !important;
        width: auto !important;
        padding: var(--framer-input-padding, 14px) !important;
        background: transparent !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        color: #0d0d0d !important;
        -webkit-text-fill-color: #0d0d0d !important;
      }

      /* Framer Badge Hydration Fallback */
      #__framer-badge-container,
      .__framer-badge {
        display: none !important;
      }

      /* 4. Footer Phone Number Layout & (WhatsApp) Line */
      .framer-gUICt .framer-y16uf {
        overflow: visible !important;
      }
      .framer-gUICt .framer-15k7w5t a::after {
        content: "(WhatsApp)";
        display: block;
        font-size: 13px;
        line-height: 1.35;
        font-weight: 400;
        color: rgba(255, 255, 255, 0.64);
        margin-top: 2px;
        text-decoration: none;
      }
      .framer-gUICt .framer-1dgqb6o .framer-y16uf .framer-koi1nl {
        display: none !important;
      }

      /* Permanent 'Work' Route Removal (Footer, Navbar, Menu Drawer — zero :has() overhead) */
      a[href="/work"],
      a[href="./work"],
      a[href$="/work"],
      .framer-gUICt .framer-9qg7n9,
      [data-framer-name="Work"] {
        display: none !important;
      }

      /* 5. Pricing Card CTA Button Cursor Fix */
      .framer-KtiaD .framer-yicckt-container,
      .framer-KtiaD .framer-upW4V,
      .framer-KtiaD .framer-l6xzuo {
        cursor: pointer !important;
      }

      /* Career Hero Heading Center Alignment */
      .framer-16yKI .framer-1fatpkw .framer-8vovdw h1,
      .framer-16yKI .framer-1fatpkw .framer-1ldoz58 h1 {
        --framer-text-alignment: center !important;
        text-align: center !important;
      }

      /* 6. Custom Desktop Translucent Cursor System */
      @media (hover: hover) and (pointer: fine) {
        html.enraux-custom-cursor,
        html.enraux-custom-cursor *,
        html.enraux-custom-cursor [class],
        html.enraux-custom-cursor [class] * {
          cursor: none !important;
        }
      }
      #enraux-cursor {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 24px !important;
        height: 24px !important;
        margin-left: -12px !important;
        margin-top: -12px !important;
        border-radius: 9999px !important;
        background: rgba(128, 128, 134, 0.38) !important;
        border: 1.5px solid rgba(255, 255, 255, 0.32) !important;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.14) !important;
        pointer-events: none !important;
        z-index: 2147483647 !important;
        opacity: 0;
        will-change: transform, opacity;
        transition: opacity 0.18s ease, width 0.16s ease, height 0.16s ease, margin 0.16s ease, background-color 0.16s ease;
        transform: translate3d(-100px, -100px, 0) scale(1);
      }
      #enraux-cursor.is-visible {
        opacity: 1;
      }
      #enraux-cursor.is-hover {
        background: rgba(128, 128, 134, 0.46) !important;
      }

      /* Immediate Cold-Load Hero CSS (0ms pure CSS animation, instant LCP, zero Framer CDN delay, zero CLS) */
      .framer-208ybr .framer-18b7vvs {
        opacity: 1 !important;
        transform: none !important;
      }

      @keyframes enrauxHeroRise {
