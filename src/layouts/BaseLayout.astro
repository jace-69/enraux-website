    <!-- Single-Open FAQ Accordion (Zero page-load overhead — Framer Motion onTap PointerEvent dispatching) -->
    <script is:inline>
      (() => {
        let isAutoClosingFaq = false;

        document.addEventListener(
          "pointerup",
          (e) => {
            if (isAutoClosingFaq || e.isPrimary === false) return;
            const clickedCard =
              e.target && typeof e.target.closest === "function"
                ? e.target.closest(".framer-0Ejqx")
