            '  <a class="enraux-drawer-link' + (isService ? ' is-active' : '') + '" href="/service">Service</a>',
            '  <a class="enraux-drawer-link' + (isPricing ? ' is-active' : '') + '" href="/pricing">Pricing</a>',
            '  <a class="enraux-drawer-link' + (isBlog ? ' is-active' : '') + '" href="/blog">Blog</a>',
            '  <a class="enraux-drawer-link' + (isContact ? ' is-active' : '') + '" href="/contact">Contact</a>',
            '</div>',
            '<div class="enraux-drawer-footer">',
            '  <div class="enraux-drawer-footer-inner">',
            '    <span>&copy; 2026 Enraux. All Rights Reserved.</span>',
            '    <div class="enraux-drawer-legal">',
            '      <a href="/terms">Terms &amp; Condition</a>',
            '      <span>&bull;</span>',
            '      <a href="/privacy">Privacy Policy</a>',
            '    </div>',
            '  </div>',
            '</div>'
          ].join("\n");
          document.body.appendChild(drawer);

          let isOpen = false;
          function setMenuState(open) {
            isOpen = open;
            drawer.classList.toggle("is-open", open);
            drawer.setAttribute("aria-hidden", open ? "false" : "true");
            document.documentElement.classList.toggle("enraux-static-menu-open", open);
            document.body.classList.toggle("enraux-static-menu-open", open);
            document.querySelectorAll(".framer-qvIpE").forEach((icon) => {
              icon.classList.toggle("enraux-icon-open", open);
            });
          }

          function handleToggle(e) {
            const trigger =
              e.target &&
              typeof e.target.closest === "function" &&
              e.target.closest(".framer-r1ebey, .framer-qvIpE, .framer-1vfl530");
            if (!trigger) return;
            if (document.querySelector(".framer-z10Ts .framer-17nx4mu-container")) return;
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            setMenuState(!isOpen);
          }

          window.addEventListener("click", handleToggle, true);
          window.addEventListener(
            "keydown",
            (e) => {
              if (e.key === "Escape" && isOpen) {
                setMenuState(false);
                return;
              }
              if ((e.key === "Enter" || e.key === " ") && e.target) {
                const trigger =
                  typeof e.target.closest === "function" &&
                  e.target.closest(".framer-r1ebey, .framer-qvIpE, .framer-1vfl530");
                if (trigger) {
                  handleToggle(e);
                }
              }
            },
            true
          );

          drawer.addEventListener("click", (e) => {
            if (e.target && e.target.closest && e.target.closest("a")) {
              setMenuState(false);
            }
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initStaticMenuDrawer);
        } else {
          initStaticMenuDrawer();
        }
      })();
    </script>

