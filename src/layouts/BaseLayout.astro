        function buildCountryOptionsHTML() {
          let html = '<option value="" disabled selected label="Country (+)">Country (+)</option>';
          PRIORITY_COUNTRIES.forEach((c) => {
            html += `<option value="${c.iso}|${c.code}">${c.name} (${c.code})</option>`;
          });
          html += '<option value="" disabled>──────────</option>';
          ALL_COUNTRIES.forEach((c) => {
            html += `<option value="${c.iso}|${c.code}">${c.name} (${c.code})</option>`;
          });
          return html;
        }

        function populateAllCountryOptions(selectEl) {
          if (!selectEl || selectEl.dataset.enrauxOptionsLoaded === "1") return;
          const currentVal = selectEl.value;
          selectEl.innerHTML = buildCountryOptionsHTML();
          selectEl.dataset.enrauxOptionsLoaded = "1";
          if (currentVal) {
            selectEl.value = currentVal;
          }
        }
        window.__populateAllCountryOptions = populateAllCountryOptions;

        const PRIMARY_ISOS = new Set(["US", "GB", "RU", "AU", "DE", "FR", "IN", "ZA", "NG", "AE"]);

        const countryMap = new Map();
        PRIORITY_COUNTRIES.forEach((c) => {
          if (!countryMap.has(c.iso)) countryMap.set(c.iso, c);
        });
        ALL_COUNTRIES.forEach((c) => {
          if (!countryMap.has(c.iso)) countryMap.set(c.iso, c);
        });

        const SORTED_DIAL_CODES = Array.from(countryMap.values()).map((c) => ({
          name: c.name,
          code: c.code,
          iso: c.iso,
          value: `${c.iso}|${c.code}`,
          digits: c.code.replace(/^\+/, "")
        }));

        SORTED_DIAL_CODES.sort((a, b) => {
          if (b.digits.length !== a.digits.length) {
            return b.digits.length - a.digits.length;
          }
          const aPri = PRIMARY_ISOS.has(a.iso) ? 1 : 0;
          const bPri = PRIMARY_ISOS.has(b.iso) ? 1 : 0;
          if (bPri !== aPri) {
            return bPri - aPri;
          }
          return a.name.localeCompare(b.name);
        });

        function matchCountryByPhoneInput(rawValue, countrySelect, optionalTelInput) {
          if (!countrySelect) return;
          const telInput =
            optionalTelInput ||
            countrySelect.closest(".enraux-phone-combo")?.querySelector('input[type="tel"]') ||
            null;
          const raw = (rawValue || "").trim();
          if (!raw.startsWith("+")) {
            if (countrySelect.dataset.enrauxSource === "auto") {
              countrySelect.selectedIndex = 0;
              delete countrySelect.dataset.enrauxSource;
            }
            if (telInput && (!raw || !raw.startsWith("+"))) {
              delete telInput.dataset.enrauxDialCode;
            }
            return;
          }

          const digitsAfterPlus = raw.slice(1).replace(/[\s\-\.\(\)]/g, "");
          if (!digitsAfterPlus) {
            if (countrySelect.dataset.enrauxSource === "auto") {
              countrySelect.selectedIndex = 0;
              delete countrySelect.dataset.enrauxSource;
            }
            if (telInput) {
              delete telInput.dataset.enrauxDialCode;
            }
            return;
          }

          let matched = null;
          for (let i = 0; i < SORTED_DIAL_CODES.length; i++) {
            const item = SORTED_DIAL_CODES[i];
            if (digitsAfterPlus.startsWith(item.digits)) {
              matched = item;
              break;
            }
          }

          if (matched) {
            if (countrySelect.dataset.enrauxSource === "manual" && countrySelect.value) {
              const curDialCode = (countrySelect.value.split("|")[1] || "").trim();
              if (curDialCode === matched.code) {
                if (telInput) {
                  telInput.dataset.enrauxDialCode = matched.code;
                }
                return;
              }
            }

            if (countrySelect.value !== matched.value) {
              if (countrySelect.dataset.enrauxOptionsLoaded !== "1") {
                populateAllCountryOptions(countrySelect);
              }
              countrySelect.value = matched.value;
            }
            countrySelect.dataset.enrauxSource = "auto";
            if (telInput) {
              telInput.dataset.enrauxDialCode = matched.code;
            }
          } else {
            if (countrySelect.dataset.enrauxSource === "auto") {
              countrySelect.selectedIndex = 0;
              delete countrySelect.dataset.enrauxSource;
            }
            if (telInput) {
              delete telInput.dataset.enrauxDialCode;
            }
          }
        }

        window.__matchCountryByPhoneInput = matchCountryByPhoneInput;

        const phoneStateCache = new Map();

        function getFormKey(telInput) {
          const form = telInput.closest("form");
          if (!form) return "default";
          const variant = telInput.closest("[data-framer-name]")?.getAttribute("data-framer-name") || "";
          return (form.getAttribute("action") || "") + ":" + variant + ":" + (telInput.name || "tel");
        }

        function triggerCountryNudge(wrap) {
          if (!wrap) return;
          wrap.classList.add("enraux-country-nudge");
          setTimeout(() => {
            wrap.classList.remove("enraux-country-nudge");
          }, 550);
        }

        function initPhoneCountryDropdowns() {
          const telInputs = document.querySelectorAll("form input[type='tel']");
          telInputs.forEach((telInput) => {
            const wrapper =
              telInput.closest(".framer-form-text-input") ||
              telInput.closest(".framer-form-input-wrapper") ||
              telInput.parentElement;
            if (!wrapper) return;

            wrapper.classList.add("enraux-phone-combo");

            let wrap = wrapper.querySelector(".enraux-country-wrap");
            let countrySelect = wrapper.querySelector("select.enraux-country-select");

            const formKey = getFormKey(telInput);
            const cachedState = phoneStateCache.get(formKey) || {};

            if (!wrap || !countrySelect || wrap.nextElementSibling !== telInput) {
              if (wrap) wrap.remove();

              wrap = document.createElement("div");
              wrap.className = "enraux-country-wrap";

              countrySelect = document.createElement("select");
              countrySelect.name = "Country Code";
              countrySelect.className = "framer-form-input enraux-country-select";
              countrySelect.setAttribute("aria-label", "Country and dialing code");
              countrySelect.required = true;
              countrySelect.innerHTML =
                '<option value="" disabled selected label="Country (+)">Country (+)</option>' +
                '<option value="US|+1">United States (+1)</option>';
              countrySelect.dataset.enrauxOptionsLoaded = "0";

              const ensureOptions = () => populateAllCountryOptions(countrySelect);
              countrySelect.addEventListener("focus", ensureOptions, { once: true });
              countrySelect.addEventListener("pointerdown", ensureOptions, { once: true });
              countrySelect.addEventListener("mousedown", ensureOptions, { once: true });
              countrySelect.addEventListener("keydown", ensureOptions, { once: true });

              wrap.appendChild(countrySelect);
              wrapper.insertBefore(wrap, telInput);

              countrySelect.dataset.enrauxBound = "true";
              countrySelect.addEventListener("change", () => {
                countrySelect.dataset.enrauxSource = "manual";
                countrySelect.setCustomValidity("");
                telInput.setCustomValidity("");
                const val = countrySelect.value;
                const state = phoneStateCache.get(formKey) || {};
                state.country = val;

                if (val && val.includes("|")) {
                  const dialCode = (val.split("|")[1] || "").trim();
                  const prevDialCode = telInput.dataset.enrauxDialCode || "";

                  telInput._isSyncingFromDropdown = true;
                  try {
                    const current = (telInput.value || "").trim();
                    if (!current) {
                      telInput.value = dialCode + " ";
                    } else if (current.startsWith("+")) {
                      let subscriber = "";
                      if (prevDialCode && current.startsWith(prevDialCode)) {
                        subscriber = current.slice(prevDialCode.length).trimStart();
                      } else {
                        const match = current.match(/^\+\d+/);
                        if (match) {
                          subscriber = current.slice(match[0].length).trimStart();
                        } else {
                          subscriber = current.slice(1).trimStart();
                        }
                      }
                      telInput.value = subscriber ? dialCode + " " + subscriber : dialCode + " ";
                    } else {
                      telInput.value = dialCode + " " + current;
                    }
                  } finally {
                    telInput._isSyncingFromDropdown = false;
                  }

                  telInput.dataset.enrauxDialCode = dialCode;
                  state.phone = telInput.value;
                  phoneStateCache.set(formKey, state);

                  telInput.focus();
                  try {
                    const len = telInput.value.length;
                    telInput.setSelectionRange(len, len);
                  } catch (err) {}
                } else {
                  const prevDialCode = telInput.dataset.enrauxDialCode || "";
                  const curTrimmed = (telInput.value || "").trim();
                  if (prevDialCode && curTrimmed === prevDialCode) {
                    telInput.value = "";
                  } else if (/^\+\d*$/.test(curTrimmed)) {
                    telInput.value = "";
                  }
                  delete telInput.dataset.enrauxDialCode;
                  state.phone = telInput.value;
                  phoneStateCache.set(formKey, state);
                }
              });
              countrySelect.addEventListener("input", () => {
                countrySelect.setCustomValidity("");
                telInput.setCustomValidity("");
              });
            }

            // Keep telInput always enabled with unified placeholder
            telInput.disabled = false;
            telInput.placeholder = "WhatsApp number (or +code)";

            if (!telInput.dataset.enrauxBound) {
              telInput.dataset.enrauxBound = "true";

              const handlePhoneInput = () => {
                if (telInput._isSyncingFromDropdown) return;
                telInput.setCustomValidity("");
                countrySelect.setCustomValidity("");
                matchCountryByPhoneInput(telInput.value, countrySelect, telInput);
                const state = phoneStateCache.get(formKey) || {};
                state.phone = telInput.value;
                if (countrySelect.value) {
                  state.country = countrySelect.value;
                }
                phoneStateCache.set(formKey, state);
              };

              telInput.addEventListener("input", handlePhoneInput);
              telInput.addEventListener("change", handlePhoneInput);
            }

            // Restore cached values if available
            if (cachedState.country && (!countrySelect.value || countrySelect.value === "")) {
              if (countrySelect.dataset.enrauxOptionsLoaded !== "1" && !countrySelect.querySelector(`option[value="${cachedState.country}"]`)) {
                populateAllCountryOptions(countrySelect);
              }
              countrySelect.value = cachedState.country;
            }
            if (cachedState.phone !== undefined && telInput.value === "") {
              telInput.value = cachedState.phone;
            }

            // Track initial dialCode if country is selected
            if (countrySelect.value && countrySelect.value.includes("|")) {
              const initialCode = (countrySelect.value.split("|")[1] || "").trim();
              if (initialCode) {
                telInput.dataset.enrauxDialCode = initialCode;
              }
            }

            // Check if input value matches any dial code on initialization
            if (telInput.value) {
              matchCountryByPhoneInput(telInput.value, countrySelect, telInput);
            }
          });
        }

        // Lifecycle executions (deferred via __enrauxWhenHydrated)
        (window.__enrauxWhenHydrated || ((fn) => fn()))(() => {
          initPhoneCountryDropdowns();
          window.addEventListener("pageshow", initPhoneCountryDropdowns);
          document.addEventListener("astro:page-load", initPhoneCountryDropdowns);

          // rAF-throttled MutationObserver during 5000ms Framer hydration window
          let isDropdownPending = false;
          const dropdownObserver = new MutationObserver(() => {
            if (isDropdownPending) return;
            isDropdownPending = true;
            requestAnimationFrame(() => {
              isDropdownPending = false;
              initPhoneCountryDropdowns();
            });
          });

          dropdownObserver.observe(document.documentElement || document.body, {
            childList: true,
            subtree: true,
          });

          setTimeout(() => {
            dropdownObserver.disconnect();
          }, 5000);
        });

        window.__initPhoneCountryDropdowns = initPhoneCountryDropdowns;

        window.__getEnrauxFormattedPhone = function (formOrDoc) {
          const root = formOrDoc || document;
          const select = root.querySelector("select.enraux-country-select");
          const tel = root.querySelector('input[type="tel"]');
          if (!tel) return "";
          let raw = (tel.value || "").trim();
          if (!select || !select.value || !select.value.includes("|")) {
            return raw;
          }
          const parts = select.value.split("|");
          const dialCode = (parts[1] || "").trim();
          if (!dialCode) return raw;

          const codeDigits = dialCode.replace(/^\+/, "");
          if (raw.startsWith(dialCode)) {
            raw = raw.slice(dialCode.length).trim();
          } else if (raw.startsWith("+" + codeDigits)) {
            raw = raw.slice(("+" + codeDigits).length).trim();
          } else if (codeDigits.length >= 2 && raw.startsWith(codeDigits)) {
            raw = raw.slice(codeDigits.length).trim();
          } else if (codeDigits === "1" && raw.startsWith("1") && raw.replace(/\D/g, "").length > 10) {
            raw = raw.slice(1).trim();
          } else if (raw.startsWith("+")) {
            raw = raw.slice(1).trim();
          }

          if (raw.startsWith("0")) {
            raw = raw.replace(/^0+/, "");
          }

          return raw ? `${dialCode} ${raw}` : dialCode;
        };
      })();
    </script>

    <!-- 'Claim Your Sprint' Submission Handler (Framer Hydration-Safe) -->
    <script is:inline>
      (() => {
        let isClaimSubmitted = false;
        let isSubmitting = false;

        function setButtonLabel(btn, text) {
          const p =
            (btn && typeof btn.querySelector === "function"
              ? btn.querySelector(".framer-104imqr p")
              : null) ||
            document.querySelector(".framer-1696s4l-container .framer-104imqr p");
          if (p) {
            p.textContent = text;
            return;
          }
          if (!btn || typeof btn.querySelector !== "function") return;
          const walker = document.createTreeWalker(btn, NodeFilter.SHOW_TEXT, null);
          let node;
          while ((node = walker.nextNode())) {
            const val = (node.nodeValue || "").trim();
            if (
              val.includes("Claim Your Sprint") ||
              val.includes("Submitting") ||
              val.includes("Sprint Claimed") ||
              val.includes("Failed") ||
              val.includes("Send a Message")
            ) {
              node.nodeValue = text;
              return;
            }
          }
        }

        function getVisibleFields(formOrDoc) {
          const root = formOrDoc || document;
          const all = Array.from(root.querySelectorAll("input, textarea, select"));
          return all.filter((el) => {
            if (
              el.type === "hidden" ||
              el.type === "submit" ||
              el.getAttribute("tabindex") === "-1" ||
              el.getAttribute("aria-hidden") === "true" ||
              el.name === "framer-noscript" ||
              el.style.transform === "scale(0)"
            ) {
              return false;
            }
            const style = window.getComputedStyle(el);
            if (style.display === "none" || style.visibility === "hidden") {
              return false;
            }
            return true;
          });
        }

        function findClaimButton(target) {
          if (!target || typeof target.closest !== "function") return null;
          const btn =
            target.closest(".framer-1696s4l-container button") ||
            target.closest("button[type='submit']") ||
            target.closest(".framer-1696s4l-container") ||
            target.closest("[data-reset='button']");
          if (!btn) return null;
          const text = (btn.textContent || "").trim();
          if (
            text.includes("Claim Your Sprint") ||
            text.includes("Submitting") ||
            text.includes("Sprint Claimed") ||
            text.includes("Failed") ||
            text.includes("Send a Message")
          ) {
            return btn.querySelector("button") || btn;
          }
          return null;
        }

        async function handleClaimProcess(btn, e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
          }

          if (isSubmitting) return;

          const form =
            (btn && typeof btn.closest === "function" ? btn.closest("form") : null) ||
            document.querySelector("form[data-framer-form]") ||
            document.querySelector("form");

          const countrySelect = form
            ? form.querySelector("select.enraux-country-select")
            : document.querySelector("select.enraux-country-select");
          const telInput = form
            ? form.querySelector('input[type="tel"]')
            : document.querySelector('input[type="tel"]');

          // 1. Run matchCountryByPhoneInput before checking empty fields (handles autofill/paste)
          if (telInput && countrySelect && typeof window.__matchCountryByPhoneInput === "function") {
            window.__matchCountryByPhoneInput(telInput.value, countrySelect, telInput);
          }
          if (countrySelect) countrySelect.setCustomValidity("");
          if (telInput) telInput.setCustomValidity("");

          // 2. Validate Country selection (must be selected and contain "|")
          if (!countrySelect || !countrySelect.value || !countrySelect.value.includes("|")) {
            if (countrySelect) {
              countrySelect.focus();
              countrySelect.scrollIntoView({ behavior: "smooth", block: "center" });
              const wrap = countrySelect.closest(".enraux-country-wrap");
              if (wrap) {
                wrap.classList.add("enraux-country-nudge");
                setTimeout(() => wrap.classList.remove("enraux-country-nudge"), 550);
              }
              countrySelect.setCustomValidity("Please select your country or start your number with +country code");
              countrySelect.reportValidity();
            }
            return;
          }

          // 3. Validate Phone subscriber digits (at least 5 subscriber digits after stripping leading +<dialCode>)
          if (telInput) {
            const parts = (countrySelect.value || "").split("|");
            const dialCode = (parts[1] || "").trim();
            const dialDigits = dialCode.replace(/^\+/, "");
            let rawTel = (telInput.value || "").trim();

            if (dialCode && rawTel.startsWith(dialCode)) {
              rawTel = rawTel.slice(dialCode.length);
            } else if (dialDigits && rawTel.startsWith("+" + dialDigits)) {
              rawTel = rawTel.slice(("+" + dialDigits).length);
            } else if (dialDigits && dialDigits.length >= 2 && rawTel.startsWith(dialDigits)) {
              rawTel = rawTel.slice(dialDigits.length);
            } else if (dialDigits === "1" && rawTel.startsWith("1") && rawTel.replace(/\D/g, "").length > 10) {
              rawTel = rawTel.slice(1);
            } else if (rawTel.startsWith("+")) {
              rawTel = rawTel.slice(1);
            }

            const subscriberDigits = rawTel.replace(/\D/g, "");
            if (subscriberDigits.length < 5) {
              telInput.focus();
              telInput.scrollIntoView({ behavior: "smooth", block: "center" });
              telInput.setCustomValidity("Please enter your full WhatsApp number");
              telInput.reportValidity();
              return;
            }
          }

          // 4. Validate other visible fields in the form
          const visible = getVisibleFields(form);
          let emptyField = null;
          for (const f of visible) {
            if (f === countrySelect || f === telInput) continue;
            const val = (f.value || "").trim();
            if (!val) {
              emptyField = f;
              break;
            }
          }

          if (emptyField) {
            emptyField.focus();
            emptyField.scrollIntoView({ behavior: "smooth", block: "center" });
            if (typeof emptyField.reportValidity === "function") emptyField.reportValidity();
            return;
          }

          // Extract fields carefully from form
          const name = (form ? (form.querySelector('input[name="Name"]') || form.querySelector('input[type="text"]:not([tabindex="-1"])')) : null)?.value?.trim() || "";
          const email = (form ? form.querySelector('input[type="email"], input[name="Email"]') : null)?.value?.trim() || "";
          const phone = typeof window.__getEnrauxFormattedPhone === "function" ? window.__getEnrauxFormattedPhone(form) : (telInput?.value?.trim() || "");
          const country = countrySelect && countrySelect.selectedIndex > 0 ? (countrySelect.options[countrySelect.selectedIndex]?.textContent || "").trim() : "";
          const service = (form ? form.querySelector('select[name="Service"]') : null)?.value?.trim() || "";
          const message = (form ? form.querySelector('textarea') : null)?.value?.trim() || "";
          const source_page = window.location.pathname;

          // website_trap: check if any hidden honeypot input[aria-hidden="true"][tabindex="-1"] in form has a non-empty .value
          let website_trap = "";
          if (form) {
            const trapInputs = form.querySelectorAll('input[aria-hidden="true"][tabindex="-1"], input[data-1p-ignore="true"][tabindex="-1"]');
            for (const trap of trapInputs) {
              if (trap && trap.value && trap.value.trim().length > 0) {
                website_trap = trap.value.trim();
                break;
              }
            }
          }

          const payload = {
            name,
            email,
            phone,
            country,
            service,
            message,
            source_page,
            website_trap,
          };

          // Loading & submission state (no DOM insertion)
          isSubmitting = true;
          setButtonLabel(btn, "Submitting...");
          if (btn && btn.style) {
            btn.style.pointerEvents = "none";
            btn.style.opacity = "0.75";
          }

          try {
            const res = await fetch("/api/contact", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(payload),
            });

            let data = null;
            try {
              data = await res.json();
            } catch (jsonErr) {}

            if (res.ok && data && data.ok) {
              setButtonLabel(btn, "Sprint Claimed ✓");
              if (btn && btn.style) {
                btn.style.pointerEvents = "auto";
                btn.style.opacity = "1";
              }

              // Clear visible input and textarea values, and reset select
              visible.forEach((f) => {
                if (f === countrySelect || f === telInput) return;
                if (f.tagName === "SELECT") {
                  f.selectedIndex = 0;
                  f.dispatchEvent(new Event("change", { bubbles: true }));
                } else {
                  f.value = "";
                  f.dispatchEvent(new Event("input", { bubbles: true }));
                }
              });

              // Also ensure textarea and select[name="Service"] are explicitly cleared if not in visible
              if (form) {
                const ta = form.querySelector("textarea");
                if (ta) {
                  ta.value = "";
                  ta.dispatchEvent(new Event("input", { bubbles: true }));
                }
                const svc = form.querySelector('select[name="Service"]');
                if (svc) {
                  svc.selectedIndex = 0;
                  svc.dispatchEvent(new Event("change", { bubbles: true }));
                }
              }

              // Reset select.enraux-country-select & input[type="tel"]
              const countrySelects = form
                ? form.querySelectorAll("select.enraux-country-select")
                : document.querySelectorAll("select.enraux-country-select");
              countrySelects.forEach((cs) => {
                cs.selectedIndex = 0;
                delete cs.dataset.enrauxSource;
                cs.setCustomValidity("");
                cs.dispatchEvent(new Event("change", { bubbles: true }));
                const combo = cs.closest(".enraux-phone-combo");
                if (combo) {
                  const tel = combo.querySelector('input[type="tel"]');
                  if (tel) {
                    tel.value = "";
                    delete tel.dataset.enrauxDialCode;
                    tel.disabled = false;
                    tel.placeholder = "WhatsApp number (or +code)";
                    tel.setCustomValidity("");
                  }
                }
              });

              // Reset any selected budget pills
              if (typeof window.__resetActiveBudgetPills === "function") {
                window.__resetActiveBudgetPills();
              }

              isClaimSubmitted = true;
              isSubmitting = false;

              // Smooth redirect to the Blog page after 750ms
              setTimeout(() => {
                window.location.href = window.location.origin + "/blog";
              }, 750);
            } else {
              throw new Error((data && data.error) || `Request failed with status ${res.status}`);
            }
          } catch (err) {
            console.error("Submission error:", err);
            isSubmitting = false;
            if (btn && btn.style) {
              btn.style.pointerEvents = "auto";
              btn.style.opacity = "1";
            }
            setButtonLabel(btn, "Failed — Try Again");
            setTimeout(() => {
              setButtonLabel(btn, "Claim Your Sprint");
            }, 2500);
          }
        }

        // Single click event listener in capture phase
        window.addEventListener(
          "click",
          (e) => {
            const btn = findClaimButton(e.target);
            if (btn) {
              handleClaimProcess(btn, e);
            }
          },
          true
        );

        // Prevent native form submission so it doesn't trigger duplicate submits or page reload
        window.addEventListener(
          "submit",
          (e) => {
            const form = e.target;
            if (
              form &&
              form.textContent &&
              (form.textContent.includes("Claim Your Sprint") ||
                form.textContent.includes("Submitting...") ||
                form.textContent.includes("Sprint Claimed") ||
                form.textContent.includes("Send a Message"))
            ) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              const btn = findClaimButton(form.querySelector("button[type='submit']"));
              if (btn) {
                handleClaimProcess(btn, e);
              }
            }
          },
          true
        );

        // Hydration Guard via MutationObserver to preserve "Sprint Claimed ✓" state without DOM insertion
        const claimObserver = new MutationObserver(() => {
          if (isClaimSubmitted) {
            const p = document.querySelector(".framer-1696s4l-container .framer-104imqr p");
            if (p && p.textContent && p.textContent.includes("Claim Your Sprint")) {
              p.textContent = "Sprint Claimed ✓";
            }
          }
        });

        claimObserver.observe(document.documentElement || document.body, {
          childList: true,
          subtree: true,
          characterData: true,
        });
      })();
    </script>

    <!-- Project Budget Pills Interactive Selection System -->
    <script is:inline>
      (() => {
        const PILL_TEXTS = [
          "$200 Ad Trial",
          "From $900 Landing Page",
          "$3.5k/mo Retainer",
          "$7.5k–$15k E-Com",
          "$7.5k-$15k E-Com",
          "$7k+ Brand Genesis",
          "Custom Enterprise"
        ];

        // Fix 3B: Query param to Service & Budget Pill mapping
        const SERVICE_PARAM_MAP = {
          "genesis": {
            service: "$7k+ Brand Genesis",
            pill: "$7k+ Brand Genesis"
          },
          "ad-trial": {
            service: "$200 Ad Creative Trial",
            pill: "$200 Ad Trial"
          },
          "landing-page": {
            service: "High-Converting Landing Page (From $900)",
            pill: "From $900 Landing Page"
          },
          "ecommerce": {
            service: "High-Scale E-Commerce ($7.5k+)",
            pill: "$7.5k–$15k E-Com"
          },
          "retainer": {
            service: "Creative & Growth Retainer ($3.5k/mo)",
            pill: "$3.5k/mo Retainer"
          },
          "saas": {
            service: "Custom SaaS / Mobile App ($5k+)",
            pill: "Custom Enterprise"
          }
        };

        let userInteractedWithService = false;
        let activeBudgetPillText = null;
        let isPillMutating = false;

        function resetUserInteraction() {
          userInteractedWithService = false;
        }

        window.addEventListener("pageshow", resetUserInteraction);
        window.addEventListener("popstate", resetUserInteraction);
        document.addEventListener("astro:page-load", resetUserInteraction);
        document.addEventListener("astro:after-swap", resetUserInteraction);

        // Listen for direct user changes on select[name="Service"]
        document.addEventListener(
          "change",
          (e) => {
            if (
              e.target &&
              e.target.name === "Service" &&
              !e.target.classList.contains("enraux-country-select") &&
              e.isTrusted
            ) {
              userInteractedWithService = true;
            }
          },
          true
        );

        function applyServiceFromUrl() {
          if (userInteractedWithService) return;
          const params = new URLSearchParams(window.location.search);
          const serviceKey = (params.get("service") || "").toLowerCase().trim();
          if (!serviceKey || !SERVICE_PARAM_MAP[serviceKey]) return;

          const target = SERVICE_PARAM_MAP[serviceKey];
          const selects = document.querySelectorAll('select[name="Service"]');
          if (selects.length === 0) return;

          selects.forEach((select) => {
            syncServiceOptions(select);
            const nativeSelectSetter = Object.getOwnPropertyDescriptor(
              window.HTMLSelectElement.prototype,
              "value"
            )?.set;
            if (nativeSelectSetter) {
              nativeSelectSetter.call(select, target.service);
            } else {
              select.value = target.service;
            }
            select.dispatchEvent(new Event("input", { bubbles: true }));
            select.dispatchEvent(new Event("change", { bubbles: true }));
          });

          // Activate matching Budget Pill
          const pills = getAllBudgetPills();
          let matchedPill = null;
          pills.forEach((p) => {
            const text = getPillCleanText(p);
            const isMatch =
              text.includes(target.pill) ||
              (target.pill.includes("E-Com") && text.includes("E-Com"));
            if (isMatch) {
              matchedPill = p;
              applyPillStyles(p, true);
            } else {
              applyPillStyles(p, false);
            }
          });

          if (matchedPill) {
            activeBudgetPillText = getPillCleanText(matchedPill);
          }
        }

        function getPillCleanText(el) {
          if (!el) return "";
          return (el.textContent || "").trim();
        }

        function isBudgetPillElement(el) {
          if (!el) return false;
          const text = getPillCleanText(el);
          return PILL_TEXTS.some((t) => text.includes(t));
        }

        function findBudgetPillFromTarget(target) {
          if (!target || typeof target.closest !== "function") return null;
          if (target.closest("select, option, input, textarea, button")) return null;
          const pill = target.closest(".framer-0WrPu");
          return pill && isBudgetPillElement(pill) ? pill : null;
        }

        function applyPillStyles(pill, isSelected) {
          if (!pill) return;
          const hasSelected = pill.classList.contains("enraux-pill-selected");
          const hasUnselected = pill.classList.contains("enraux-pill-unselected");
          if (isSelected && hasSelected && pill.style.backgroundColor === "rgb(10, 10, 10)") {
            return;
          }
          if (!isSelected && hasUnselected && pill.style.backgroundColor === "rgb(255, 255, 255)") {
            return;
          }

          const bg = isSelected ? "#0a0a0a" : "#ffffff";
          const fg = isSelected ? "#ffffff" : "#0a0a0a";
          const border = isSelected ? "#0a0a0a" : "rgba(10, 10, 10, 0.15)";

          if (isSelected) {
            pill.classList.add("enraux-pill-selected");
            pill.classList.remove("enraux-pill-unselected");
          } else {
            pill.classList.remove("enraux-pill-selected");
            pill.classList.add("enraux-pill-unselected");
          }

          pill.style.setProperty("background-color", bg, "important");
          pill.style.setProperty("color", fg, "important");
          pill.style.setProperty("--border-color", border, "important");
          pill.style.setProperty("border-color", border, "important");

          const textElements = pill.querySelectorAll("p, span, .framer-text, div");
